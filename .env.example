# 1. Groq API
GROQ_API_KEY=gsk_...
GROQ_MODEL=openai/gpt-oss-120b

# 2. Slack Tokens (Socket Mode)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# 3. Vector Database (Qdrant Cloud)
QDRANT_URL=https://<your-cluster>.qdrant.io
QDRANT_API_KEY=...

# 4. Observability (Langfuse)
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

# 5. Jira REST API (Optional - Falls back to mock mode if unset)
JIRA_SERVER=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@nexatech.com
JIRA_API_TOKEN=your-atlassian-api-token

# 6. MongoDB Chat History & Thread Memory (Leave blank for in-memory fallback)
MONGODB_URI=
MONGODB_DB_NAME=drona_db
MONGODB_COLLECTION=chat_history
